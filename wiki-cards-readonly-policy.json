{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::michaels-assets"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "wiki-cards/",
            "wiki-cards/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::michaels-assets/wiki-cards/*"
      ]
    }
  ]
}
